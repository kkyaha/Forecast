   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Đặc trưng thời gian (Calendar Features)\n",
    "df['month'] = df.index.month\n",
    "df['day_of_year'] = df.index.dayofyear\n",
    "df['year'] = df.index.year\n",
    "\n",
    "# 2. Đặc trưng trượt (Rolling / Lag Features) trên meantemp\n",
    "df['temp_lag_1'] = df['meantemp'].shift(1)        # Nhiệt độ hôm qua\n",
    "df['temp_lag_7'] = df['meantemp'].shift(7)        # Nhiệt độ 1 tuần trước\n",
    "df['temp_lag_365'] = df['meantemp'].shift(365)    # Nhiệt độ cùng ngày năm trước\n",
    "df['temp_roll_7'] = df['meantemp'].rolling(7).mean()    # Trung bình trượt 7 ngày\n",
    "df['temp_roll_30'] = df['meantemp'].rolling(30).mean()  # Trung bình trượt 30 ngày\n",
    "\n",
    "# 3. Trực quan hóa trung bình trượt\n",
    "fig, ax = plt.subplots(figsize=(14, 5))\n",
    "ax.plot(df.index, df['meantemp'], alpha=0.4, color='#BDC3C7', label='Chuỗi gốc (daily)')\n",
    "ax.plot(df.index, df['temp_roll_7'], color='#E74C3C', linewidth=1.5, label='Trung bình trượt 7 ngày')\n",
    "ax.plot(df.index, df['temp_roll_30'], color='#2C3E50', linewidth=2, label='Trung bình trượt 30 ngày')\n",
