   "source": [
    "---\n",
    "## 2. LÀM SẠCH DỮ LIỆU (Data Cleaning)\n",
    "\n",
    "### 2.1. Kiểm tra dữ liệu khuyết & trùng lặp"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Kiểm tra NaN\n",
    "print(\"1. Số giá trị NaN theo từng cột:\")\n",
    "print(df_raw.isnull().sum().to_frame(\"NaN count\"))\n",
