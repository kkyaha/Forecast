    "print(f\"  - meantemp vs wind_speed: r = {corr_matrix.loc['meantemp','wind_speed']:.3f}\")\n",
    "print(f\"  - meantemp vs meanpressure: r = {corr_matrix.loc['meantemp','meanpressure']:.3f}\")"
   ]
