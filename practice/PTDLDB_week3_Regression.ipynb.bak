   ],
   "source": [
    "# ── Bản sao để làm việc ─────────────────────────────────────────────────────\n",
    "df = df_raw.copy()\n",
    "\n",
    "# ── Encode target ngay để tiện sử dụng ──────────────────────────────────────\n",
    "df['y'] = df['y'].map({'no': 0, 'yes': 1})\n",
    "\n",
    "# ── IQR Clipping trên các biến số dễ bị outlier ─────────────────────────────\n",
    "numeric_cols = ['age', 'balance', 'duration', 'campaign', 'pdays', 'previous']\n",
    "\n",
    "print(\"THỐNG KÊ TRƯỚC KHI XỬ LÝ OUTLIER:\")\n",
    "print(df[numeric_cols].describe().round(2))\n",
    "print()\n",
    "\n",
    "before_stats = {}\n",
    "for col in numeric_cols:\n",
    "    Q1 = df[col].quantile(0.25)\n",
    "    Q3 = df[col].quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    lower = Q1 - 1.5 * IQR\n",
    "    upper = Q3 + 1.5 * IQR\n",
    "    n_out = ((df[col] < lower) | (df[col] > upper)).sum()\n",
    "    before_stats[col] = {'Min': df[col].min(), 'Max': df[col].max(), 'Outliers': n_out}\n",
    "    df[col] = df[col].clip(lower=lower, upper=upper)\n",
    "\n",
    "print(\"TỔNG KẾT OUTLIER SAU KHI CLIP:\")\n",
    "df_out_summary = pd.DataFrame(before_stats).T\n",
    "display(df_out_summary)\n",
    "print()\n",
    "print(\"THỐNG KÊ SAU KHI XỬ LÝ OUTLIER:\")\n",
    "print(df[numeric_cols].describe().round(2))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f96d8ef6",
   "metadata": {},
   "source": [
    "### 2.3. Encode biến phân loại & Tách X, y\n",
    "\n",
    "**One-Hot Encoding** (`pd.get_dummies`, `drop_first=True`) biến đổi 9 cột categorical thành 35 biến nhị phân, mang tổng số đặc trưng từ 16 lên **42 features**."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "c3caf8f8",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-25T11:10:21.114516Z",
     "iopub.status.busy": "2026-09-25T11:10:21.114457Z",
     "iopub.status.idle": "2026-09-25T11:10:21.129986Z",
     "shell.execute_reply": "2026-09-25T11:10:21.129775Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ Kích thước X_all: (45211, 41)  |  y_reg (duration): (45211,)  |  y_cls (0/1): (45211,)\n",
      "Danh sách 41 features sau encoding:\n",
      "['age', 'balance', 'day', 'campaign', 'pdays', 'previous', 'job_blue-collar', 'job_entrepreneur', 'job_housemaid', 'job_management', 'job_retired', 'job_self-employed', 'job_services', 'job_student', 'job_technician', 'job_unemployed', 'job_unknown', 'marital_married', 'marital_single', 'education_secondary', 'education_tertiary', 'education_unknown', 'default_yes', 'housing_yes', 'loan_yes', 'contact_telephone', 'contact_unknown', 'month_aug', 'month_dec', 'month_feb', 'month_jan', 'month_jul', 'month_jun', 'month_mar', 'month_may', 'month_nov', 'month_oct', 'month_sep', 'poutcome_other', 'poutcome_success', 'poutcome_unknown']\n"
     ]
    }
   ],
   "source": [
    "# ── One-Hot Encoding toàn bộ cột categorical ────────────────────────────────\n",
    "feature_cols = [c for c in df.columns if c not in ['y', 'duration']]\n",
    "X_all = pd.get_dummies(df[feature_cols + ['duration']], drop_first=True)\n",
    "\n",
    "# Tách biến mục tiêu\n",
    "y_cls  = df['y']                           # Cho bài toán phân loại (Logistic)\n",
    "y_reg  = X_all.pop('duration')             # Cho bài toán hồi quy (SLR, MLR, Poly)\n",
    "# X_all bây giờ không còn 'duration'\n",
    "\n",
    "print(f\"✅ Kích thước X_all: {X_all.shape}  |  y_reg (duration): {y_reg.shape}  |  y_cls (0/1): {y_cls.shape}\")\n",
    "print(f\"Danh sách {X_all.shape[1]} features sau encoding:\")\n",
    "print(X_all.columns.tolist())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "04e764b5",
   "metadata": {},
   "source": [
    "---\n",
    "## 3. FEATURE SELECTION (Lựa chọn đặc trưng)\n",
    "\n",
    "Áp dụng lại 2 phương pháp từ Tuần 2 trên **toàn bộ 42 đặc trưng** với biến mục tiêu phân loại `y`:\n",
    "- **RFECV** — Wrapper method (Logistic Regression + 3-Fold CV)\n",
    "- **Random Forest SelectFromModel** — Embedded method (MDI ≥ mean)\n",
    "\n",
    "Kết quả: lấy phần giao nhau (**Consensus features**) làm tập đặc trưng \"vàng\" cho các mô hình."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "49122de2",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-25T11:10:21.130916Z",
     "iopub.status.busy": "2026-09-25T11:10:21.130857Z",
     "iopub.status.idle": "2026-09-25T11:10:21.163251Z",
     "shell.execute_reply": "2026-09-25T11:10:21.163044Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Train set: (36168, 41)  |  Test set: (9043, 41)\n"
     ]
    }
   ],
   "source": [
    "# ── Train/Test split (dùng y phân loại để stratify) ─────────────────────────\n",
    "X_tr, X_te, yr_tr, yr_te, yc_tr, yc_te = train_test_split(\n",
    "    X_all, y_reg, y_cls,\n",
    "    test_size=0.2, random_state=42, stratify=y_cls\n",
    ")\n",
    "\n",
    "# ── Chuẩn hóa Z-score trên tập Train ─────────────────────────────────────────\n",
    "scaler = StandardScaler()\n",
    "X_tr_sc = pd.DataFrame(scaler.fit_transform(X_tr), columns=X_tr.columns)\n",
    "X_te_sc = pd.DataFrame(scaler.transform(X_te),    columns=X_te.columns)\n",
    "\n",
    "print(f\"Train set: {X_tr_sc.shape}  |  Test set: {X_te_sc.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "55babbad",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-25T11:10:21.164135Z",
     "iopub.status.busy": "2026-09-25T11:10:21.164079Z",
     "iopub.status.idle": "2026-09-25T11:10:22.898482Z",
     "shell.execute_reply": "2026-09-25T11:10:22.898218Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "⏳ Đang chạy RFECV...\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ RFECV: Giữ lại 3 cột | Loại bỏ 38 cột\n",
      "   Các cột bị loại: ['age', 'balance', 'day', 'campaign', 'pdays', 'previous', 'job_blue-collar', 'job_entrepreneur', 'job_housemaid', 'job_management', 'job_retired', 'job_self-employed', 'job_services', 'job_student', 'job_technician', 'job_unemployed', 'job_unknown', 'marital_married', 'marital_single', 'education_secondary', 'education_tertiary', 'education_unknown', 'default_yes', 'loan_yes', 'contact_telephone', 'month_aug', 'month_dec', 'month_feb', 'month_jan', 'month_jul', 'month_jun', 'month_mar', 'month_may', 'month_nov', 'month_oct', 'month_sep', 'poutcome_other', 'poutcome_unknown']\n"
     ]
    }
   ],
   "source": [
    "# ── 3.1 RFECV ────────────────────────────────────────────────────────────────\n",
    "print(\"⏳ Đang chạy RFECV...\")\n",
    "estimator = LogisticRegression(solver='liblinear', max_iter=1000, random_state=42)\n",
    "cv_kfold  = StratifiedKFold(n_splits=3, shuffle=True, random_state=42)\n",
    "rfecv = RFECV(estimator=estimator, step=2, cv=cv_kfold, scoring='f1', n_jobs=1)\n",
    "rfecv.fit(X_tr_sc, yc_tr)\n",
    "\n",
    "rfecv_features = X_tr_sc.columns[rfecv.support_].tolist()\n",
    "rfecv_elim     = X_tr_sc.columns[~rfecv.support_].tolist()\n",
    "\n",
    "print(f\"✅ RFECV: Giữ lại {len(rfecv_features)} cột | Loại bỏ {len(rfecv_elim)} cột\")\n",
    "print(f\"   Các cột bị loại: {rfecv_elim}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "c34c925b",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-25T11:10:22.899487Z",
     "iopub.status.busy": "2026-09-25T11:10:22.899421Z",
     "iopub.status.idle": "2026-09-25T11:10:23.058968Z",
     "shell.execute_reply": "2026-09-25T11:10:23.058641Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "⏳ Đang chạy Random Forest...\n",
      "✅ RF (ngưỡng MDI=0.02439): Giữ lại 10 cột | Loại bỏ 31 cột\n",
      "   Các cột bị loại: ['campaign', 'pdays', 'previous', 'job_blue-collar', 'job_entrepreneur', 'job_housemaid', 'job_management', 'job_retired', 'job_self-employed', 'job_services', 'job_student', 'job_technician', 'job_unemployed', 'job_unknown', 'marital_married']...\n"
     ]
    }
   ],
   "source": [
    "# ── 3.2 Random Forest SelectFromModel ───────────────────────────────────────\n",
    "print(\"⏳ Đang chạy Random Forest...\")\n",
    "rf_model   = RandomForestClassifier(n_estimators=50, max_depth=8, n_jobs=-1, random_state=42)\n",
    "rf_model.fit(X_tr_sc, yc_tr)\n",
    "\n",
    "rf_selector  = SelectFromModel(rf_model, threshold='mean', prefit=True)\n",
    "threshold_val = rf_model.feature_importances_.mean()\n",
    "rf_features  = X_tr_sc.columns[rf_selector.get_support()].tolist()\n",
    "rf_elim      = X_tr_sc.columns[~rf_selector.get_support()].tolist()\n",
    "\n",
    "print(f\"✅ RF (ngưỡng MDI={threshold_val:.5f}): Giữ lại {len(rf_features)} cột | Loại bỏ {len(rf_elim)} cột\")\n",
    "print(f\"   Các cột bị loại: {rf_elim[:15]}{'...' if len(rf_elim) > 15 else ''}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "591110de",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-25T11:10:23.060168Z",
     "iopub.status.busy": "2026-09-25T11:10:23.060085Z",
     "iopub.status.idle": "2026-09-25T11:10:23.062830Z",
     "shell.execute_reply": "2026-09-25T11:10:23.062587Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ CONSENSUS: 3 đặc trưng xuất hiện ở cả 2 phương pháp\n",
      "   ['contact_unknown', 'housing_yes', 'poutcome_success']\n"
     ]
    }
   ],
   "source": [
    "# ── 3.3 Consensus Features ──────────────────────────────────────────────────\n",
    "consensus_features = sorted(list(set(rfecv_features) & set(rf_features)))\n",
    "print(f\"✅ CONSENSUS: {len(consensus_features)} đặc trưng xuất hiện ở cả 2 phương pháp\")\n",
    "print(f\"   {consensus_features}\")\n",
    "\n",
    "# Tập dữ liệu sau chọn lọc (dùng cho hồi quy và logistic)\n",
    "X_tr_sel = X_tr_sc[consensus_features]\n",
    "X_te_sel = X_te_sc[consensus_features]"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ceca4194",
   "metadata": {},
   "source": [
    "---\n",
    "## 4. GIẢM CHIỀU DỮ LIỆU (Dimensionality Reduction)\n",
    "\n",
    "### 4.1. PCA — Giảm chiều không giám sát\n",
    "\n",
    "Giữ đủ số thành phần chính để giải thích **≥ 95% tổng phương sai** của tập Consensus features."
   ]
