   "source": [
    "# ── PCA trên Consensus features ─────────────────────────────────────────────\n",
    "pca = PCA(n_components=0.95, random_state=42)\n",
    "X_tr_pca = pca.fit_transform(X_tr_sel)\n",
    "X_te_pca = pca.transform(X_te_sel)\n",
    "\n",
    "explained = pca.explained_variance_ratio_.cumsum()\n",
    "n_pca = X_tr_pca.shape[1]\n",
    "\n",
    "print(f\"✅ PCA: {len(consensus_features)} chiều → {n_pca} thành phần chính\")\n",
    "print(f\"   Phương sai tích lũy: {explained[-1]*100:.2f}%\")\n",
    "\n",
    "# Vẽ Scree plot\n",
    "fig, ax = plt.subplots(figsize=(8, 4))\n",
    "ax.plot(range(1, n_pca + 1), explained * 100, 'o-', color='#4A90D9', lw=2.5, ms=8)\n",
    "ax.axhline(95, ls='--', color='#E74C3C', lw=1.5, label='Ngưỡng 95%')\n",
    "ax.fill_between(range(1, n_pca + 1), explained * 100, alpha=0.15, color='#4A90D9')\n",
    "ax.set(xlabel='Số thành phần chính', ylabel='Phương sai tích lũy (%)',\n",
    "       title='📊 PCA Scree Plot — Phương sai tích lũy (Consensus Features)')\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
