   "source": [
    "# ── TRỰC QUAN HÓA SO SÁNH HIỆU NĂNG (CONFUSION MATRIX, ROC & PR CURVES) ───────\n",
    "fig = plt.figure(figsize=(18, 5))\n",
    "\n",
    "# Plot 1, 2, 3: Confusion Matrix cho 3 cấu hình\n",
    "for idx, (name, res) in enumerate(lr_results.items(), start=1):\n",
    "    ax = plt.subplot(1, 4, idx)\n",
    "    cm = confusion_matrix(yc_te, res['ypred'])\n",
    "    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', cbar=False, ax=ax,\n",
    "                xticklabels=['Pred: No', 'Pred: Yes'],\n",
    "                yticklabels=['True: No', 'True: Yes'])\n",
    "    ax.set_title(f'Confusion Matrix\\n({name})', fontsize=10, fontweight='bold')\n",
    "\n",
    "# Plot 4: So sánh ROC Curves\n",
    "ax4 = plt.subplot(1, 4, 4)\n",
    "colors = {'Consensus Features': '#3498DB', 'PCA Reduced': '#2ECC71', 'LDA Reduced': '#E74C3C'}\n",
    "for name, res in lr_results.items():\n",
    "    fpr, tpr, _ = roc_curve(yc_te, res['yprob'])\n",
    "    ax4.plot(fpr, tpr, lw=2.2, color=colors[name], label=f\"{name} (AUC={res['auc']:.3f})\")\n",
    "\n",
    "ax4.plot([0, 1], [0, 1], 'k--', lw=1.2, label='Random Guess')\n",
    "ax4.set_xlabel('False Positive Rate (FPR)')\n",
    "ax4.set_ylabel('True Positive Rate (TPR)')\n",
    "ax4.set_title('Đường cong ROC Curves', fontsize=11, fontweight='bold')\n",
    "ax4.legend(loc='lower right', fontsize=8.5)\n",
    "\n",
    "plt.suptitle('📊 ĐÁNH GIÁ TOÀN DIỆN MÔ HÌNH HỒI QUY LOGISTIC', fontsize=13, fontweight='bold', y=1.03)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Classification Report chi tiết của mô hình Consensus Features\n",
    "print(\"\\n\" + \"=\" * 65)\n",
    "print(\"📋 CHI TIẾT BÁO CÁO PHÂN LOẠI (CONSENSUS FEATURES):\")\n",
    "print(\"=\" * 65)\n",
    "print(classification_report(yc_te, lr_results['Consensus Features']['ypred'], \n",
    "                            target_names=['Từ chối (No - 0)', 'Gửi tiền (Yes - 1)']))\n"
   ]
  },
