      "\n",
      "THỐNG KÊ SAU KHI XỬ LÝ OUTLIER:\n",
      "            age   balance  duration  campaign    pdays  previous\n",
      "count  45211.00  45211.00  45211.00  45211.00  45211.0   45211.0\n",
      "mean      40.87    933.71    234.94      2.39     -1.0       0.0\n",
      "std       10.39   1176.77    176.75      1.60      0.0       0.0\n",
      "min       18.00  -1962.00      0.00      1.00     -1.0       0.0\n",
      "25%       33.00     72.00    103.00      1.00     -1.0       0.0\n",
      "50%       39.00    448.00    180.00      2.00     -1.0       0.0\n",
      "75%       48.00   1428.00    319.00      3.00     -1.0       0.0\n",
