   "source": [
    "# ── KIỂM ĐỊNH 1: THỬ NGHIỆM LINEAR PROBABILITY MODEL (OLS TRÊN BIẾN MỤC TIÊU Y) ─\n",
    "from sklearn.linear_model import LinearRegression\n",
    "\n",
    "# Thử nghiệm Hồi quy Tuyến tính trực tiếp lên y (biến nhị phân 0/1)\n",
    "lpm = LinearRegression()\n",
    "lpm.fit(X_tr_sc, yc_tr)\n",
    "y_lpm_pred = lpm.predict(X_te_sc)\n",
    "\n",
    "# Thống kê vi phạm miền xác suất [0, 1]\n",
    "neg_preds = (y_lpm_pred < 0).sum()\n",
    "gt1_preds = (y_lpm_pred > 1).sum()\n",
    "residuals_lpm = yc_te.values - y_lpm_pred\n",
    "\n",
    "print(\"=\" * 75)\n",
    "print(\"📊 KẾT QUẢ KIỂM ĐỊNH LINEAR PROBABILITY MODEL (HỒI QUY TUYẾN TÍNH TRÊN Y)\")\n",
    "print(\"=\" * 75)\n",
    "print(f\"• Khoảng giá trị dự báo [Min, Max] : [{y_lpm_pred.min():.4f}, {y_lpm_pred.max():.4f}]\")\n",
    "print(f\"• Số mẫu dự báo xác suất âm (< 0) : {neg_preds} mẫu ({neg_preds / len(y_lpm_pred) * 100:.2f}%)\")\n",
    "print(f\"• Số mẫu dự báo vượt quá 1 (> 1)   : {gt1_preds} mẫu ({gt1_preds / len(y_lpm_pred) * 100:.2f}%)\")\n",
    "print(f\"• R² Score trên tập Test           : {r2_score(yc_te, y_lpm_pred):.4f}\")\n",
    "\n",
    "# Trực quan hóa sự vi phạm của Linear Probability Model\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Plot 1: Phân phối giá trị dự báo của OLS\n",
    "ax = axes[0]\n",
    "sns.histplot(y_lpm_pred, bins=50, kde=True, color='#3498DB', ax=ax)\n",
    "ax.axvline(0, color='#E74C3C', ls='--', lw=2, label='Ranh giới xác suất = 0')\n",
    "ax.axvline(1, color='#E74C3C', ls='--', lw=2, label='Ranh giới xác suất = 1')\n",
    "ax.axvspan(y_lpm_pred.min(), 0, color='#E74C3C', alpha=0.15, label='Vùng xác suất phi lý (< 0)')\n",
    "ax.set_title('Phân phối Giá trị Dự báo của Linear Regression\\n(Xuất hiện xác suất phi lý âm < 0)', fontsize=11, fontweight='bold')\n",
    "ax.set_xlabel(r'Giá trị dự báo $\\hat{y}$')\n",
    "ax.set_ylabel('Số lượng mẫu')\n",
    "ax.legend(loc='upper right', fontsize=8.5)\n",
    "\n",
    "# Plot 2: Biểu đồ Phần dư (Residuals vs Fitted)\n",
    "ax = axes[1]\n",
    "ax.scatter(y_lpm_pred, residuals_lpm, alpha=0.15, color='#2C3E50', s=10)\n",
    "ax.axhline(0, color='#E74C3C', ls='--', lw=1.5)\n",
    "ax.set_title('Biểu đồ Residuals vs. Fitted\\n(Vi phạm nghiêm trọng giả định Homoscedasticity & Normality)', fontsize=11, fontweight='bold')\n",
    "ax.set_xlabel(r'Giá trị dự báo $\\hat{y}$')\n",
    "ax.set_ylabel(r'Phần dư ($y - \\hat{y}$)')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
